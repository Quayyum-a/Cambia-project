# JWT Secret for authentication
JWT_SECRET=dev_secret_key_for_testing

# Database configuration - using demo mode for testing
USE_SUPABASE=false

# Supabase configuration (placeholder values - would need real values for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Sui blockchain configuration
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_PACKAGE_ID=
LOGISTICS_PUBKEY=

# IPFS/Pinata configuration
PINATA_JWT=

# Optional MongoDB URIs (fallback)
MONGODB_URI=mongodb://localhost:27017/cambia
MONGODB_TEST_URI=mongodb://localhost:27017/cambia_test

# Server port
PORT=3000

# Google OAuth for zkLogin (replace with your actual credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/zklogin/google/callback

# zkLogin configuration
ZKLOGIN_SALT=cambia-zklogin-salt-2024-secure